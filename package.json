{
  "name": "github-account-manager",
  "displayName": "GitHub Account & Git Identity Manager",
  "description": "Production-grade Windows & VS Code tool for seamlessly switching and managing multiple GitHub accounts and Git identities.",
  "version": "1.5.0",
  "publisher": "mohammed-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohamed-mostafa-98/Git-Identity-Manager-for-Windows-VS-Code.git"
  },
  "homepage": "https://github.com/mohamed-mostafa-98/Git-Identity-Manager-for-Windows-VS-Code",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "github",
    "git",
    "account switcher",
    "identity",
    "gcm",
    "ssh",
    "credentials"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:git-commit",
    "onCommand:githubAccountManager.openDashboard",
    "onCommand:githubAccountManager.switchAccount",
    "onCommand:githubAccountManager.addAccount",
    "onCommand:githubAccountManager.mapProject",
    "onCommand:githubAccountManager.diagnostics",
    "workspaceContains:.git",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "githubAccountManager.saveToken",
        "title": "GitHub: Save or Update Account Token",
        "category": "GitHub Manager",
        "icon": "$(key)"
      },
      {
        "command": "githubAccountManager.reauthenticate",
        "title": "GitHub: Reauthenticate Browser Account",
        "category": "GitHub Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "githubAccountManager.openDashboard",
        "title": "GitHub: Open Control Panel Dashboard",
        "category": "GitHub Manager",
        "icon": "$(dashboard)"
      },
      {
        "command": "githubAccountManager.switchAccount",
        "title": "GitHub: Switch Account Profile",
        "category": "GitHub Manager",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "githubAccountManager.addAccount",
        "title": "GitHub: Add Account Profile",
        "category": "GitHub Manager",
        "icon": "$(add)"
      },
      {
        "command": "githubAccountManager.removeAccount",
        "title": "GitHub: Remove Account Profile",
        "category": "GitHub Manager",
        "icon": "$(trash)"
      },
      {
        "command": "githubAccountManager.currentAccount",
        "title": "GitHub: Current Active Account",
        "category": "GitHub Manager"
      },
      {
        "command": "githubAccountManager.mapProject",
        "title": "GitHub: Map Project to Account",
        "category": "GitHub Manager",
        "icon": "$(add)"
      },
      {
        "command": "githubAccountManager.removeMapping",
        "title": "GitHub: Remove Repository Mapping",
        "category": "GitHub Manager",
        "icon": "$(trash)"
      },
      {
        "command": "githubAccountManager.repositoryStatus",
        "title": "GitHub: Repository Account Status",
        "category": "GitHub Manager"
      },
      {
        "command": "githubAccountManager.diagnostics",
        "title": "GitHub: Run Diagnostics",
        "category": "GitHub Manager"
      },
      {
        "command": "githubAccountManager.validateAuthentication",
        "title": "GitHub: Validate Authentication Health",
        "category": "GitHub Manager",
        "icon": "$(shield)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "githubAccountManager.openDashboard",
          "when": "view == githubAccountProfilesTree || view == githubRepoMappingsTree",
          "group": "navigation@1"
        },
        {
          "command": "githubAccountManager.addAccount",
          "when": "view == githubAccountProfilesTree",
          "group": "navigation@2"
        },
        {
          "command": "githubAccountManager.switchAccount",
          "when": "view == githubAccountProfilesTree",
          "group": "navigation@3"
        },
        {
          "command": "githubAccountManager.mapProject",
          "when": "view == githubRepoMappingsTree",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "githubAccountManager.switchAccount",
          "when": "view == githubAccountProfilesTree && viewItem == profileItemInactive",
          "group": "inline@1"
        },
        {
          "command": "githubAccountManager.validateAuthentication",
          "when": "view == githubAccountProfilesTree",
          "group": "inline@2"
        },
        {
          "command": "githubAccountManager.removeAccount",
          "when": "view == githubAccountProfilesTree",
          "group": "inline@3"
        },
        {
          "command": "githubAccountManager.removeMapping",
          "when": "view == githubRepoMappingsTree",
          "group": "inline@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "github-account-manager-view",
          "title": "GitHub Manager",
          "icon": "$(account)"
        }
      ]
    },
    "views": {
      "github-account-manager-view": [
        {
          "id": "githubAccountProfilesTree",
          "name": "Account Profiles"
        },
        {
          "id": "githubRepoMappingsTree",
          "name": "Repository Mappings"
        }
      ]
    },
    "configuration": {
      "title": "GitHub Account & Git Identity Manager",
      "properties": {
        "githubAccountManager.pushGuardMode": {
          "type": "string",
          "enum": [
            "Warn",
            "Strict",
            "Disabled"
          ],
          "default": "Warn",
          "description": "Protection behavior when pushing with an account that does not match the configured repository mapping."
        },
        "githubAccountManager.autoSwitchOnWorkspaceOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically activate the mapped account profile when opening a Git workspace."
        },
        "githubAccountManager.gitConfigScope": {
          "type": "string",
          "enum": [
            "LocalRepo",
            "IncludeIf"
          ],
          "default": "LocalRepo",
          "description": "Method for managing repository git user.name and user.email identities."
        },
        "githubAccountManager.enableGcmHttpPath": {
          "type": "boolean",
          "default": true,
          "description": "Legacy setting: saved HTTPS authentication always enables GitHub credential path isolation."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "test:unit": "npm run compile && mocha --ui tdd \"out/test/suite/*.test.js\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "^18.11.18",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "^2.2.3",
    "mocha": "^10.2.0",
    "typescript": "^4.9.4"
  }
}
